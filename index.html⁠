<!DOCTYPE html>
<html lang="ckb" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Patente B — Quiz &amp; VIP Video</title>
  <style>
    /* Design tokens & adaptive palette */
    :root {
      --bg: #070b14;
      --surface: #0f172a;
      --card: #111827;
      --card-2: #1e293b;
      --text: #f8fafc;
      --muted: #94a3b8;
      --accent: #38bdf8;
      --accent-2: #6366f1;
      --vip: #f59e0b;
      --vero: #22c55e;
      --falso: #ef4444;
      --border: rgba(148, 163, 184, 0.18);
      --radius-lg: 18px;
      --radius-md: 12px;
      --shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    }

    @media (prefers-color-scheme: light) {
      :root {
        --bg: #f1f5f9;
        --surface: #ffffff;
        --card: #ffffff;
        --card-2: #e2e8f0;
        --text: #0f172a;
        --muted: #475569;
        --accent: #0284c7;
        --accent-2: #4f46e5;
        --vip: #d97706;
        --vero: #16a34a;
        --falso: #dc2626;
        --border: rgba(15, 23, 42, 0.12);
        --shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
      }
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: radial-gradient(circle at top right, rgba(56, 189, 248, 0.08), transparent 45%), var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding: 16px;
    }

    .app {
      max-width: 820px;
      margin: 0 auto;
    }

    /* Non-blocking notification banner replacing alert() */
    .toast {
      display: none;
      margin-bottom: 12px;
      padding: 12px 16px;
      border-radius: var(--radius-md);
      background: var(--card-2);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      font-size: 14px;
      line-height: 1.6;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .toast.show {
      display: flex;
    }

    .toast-close {
      background: transparent;
      border: none;
      color: var(--muted);
      font-size: 16px;
      padding: 2px 6px;
      cursor: pointer;
    }

    .header {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 18px;
      margin-bottom: 14px;
      box-shadow: var(--shadow);
    }

    .header-top {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
    }

    .brand {
      font-size: 20px;
      font-weight: 800;
      letter-spacing: 0.2px;
      color: var(--accent);
    }

    .badge-vip {
      background: rgba(245, 158, 11, 0.16);
      color: var(--vip);
      border: 1px solid rgba(245, 158, 11, 0.4);
      padding: 7px 14px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }

    .controls {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 10px;
    }

    select,
    button,
    input {
      font-family: inherit;
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
      padding: 11px 14px;
      font-size: 14px;
      color: var(--text);
      background: var(--card-2);
      outline: none;
    }

    select:focus,
    input:focus,
    button:focus-visible {
      border-color: var(--accent);
    }

    button {
      cursor: pointer;
      font-weight: 600;
      transition: transform 0.12s ease, opacity 0.15s ease;
    }

    button:active {
      transform: scale(0.98);
    }

    button:hover {
      opacity: 0.92;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: #ffffff;
      border: none;
      font-weight: 800;
    }

    .btn-vip {
      background: var(--vip);
      color: #1f1200;
      border: none;
      font-weight: 800;
    }

    .progress-wrap {
      background: var(--card-2);
      height: 10px;
      border-radius: 999px;
      overflow: hidden;
      margin-top: 14px;
    }

    .progress-bar {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--accent), var(--vero));
      transition: width 0.25s ease;
    }

    .meta-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 8px;
      margin-top: 10px;
      font-size: 13px;
      color: var(--muted);
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--shadow);
    }

    .q-it {
      direction: ltr;
      text-align: left;
      font-size: 18px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 10px;
      line-height: 1.5;
    }

    .q-ku {
      font-size: 18px;
      line-height: 1.75;
      margin-bottom: 16px;
    }

    .media-area {
      margin-bottom: 16px;
    }

    .media-area img,
    .media-area video {
      width: 100%;
      max-height: 320px;
      object-fit: contain;
      border-radius: 14px;
      background: #000000;
      display: none;
    }

    .vip-lock {
      display: none;
      background: rgba(245, 158, 11, 0.08);
      border: 1px dashed var(--vip);
      border-radius: 14px;
      padding: 18px;
      text-align: center;
    }

    .vip-lock h3 {
      margin: 0 0 8px;
      color: var(--vip);
      font-size: 17px;
    }

    .vip-lock p {
      margin: 0 0 12px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.6;
    }

    .vip-form {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
    }

    .answers {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 14px;
    }

    @media (max-width: 520px) {
      .answers {
        grid-template-columns: 1fr;
      }
    }

    .btn-vero {
      background: var(--vero);
      color: #ffffff;
      border: none;
      padding: 14px;
      font-size: 16px;
      font-weight: 800;
    }

    .btn-falso {
      background: var(--falso);
      color: #ffffff;
      border: none;
      padding: 14px;
      font-size: 16px;
      font-weight: 800;
    }

    .feedback {
      display: none;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 14px;
      line-height: 1.7;
      margin-bottom: 14px;
    }

    .nav {
      display: flex;
      justify-content: space-between;
      gap: 10px;
    }

    .nav button {
      flex: 1;
    }
  </style>
</head>
<body>
  <div class="app">
    <!-- Banner message container -->
    <div id="toastBox" class="toast" role="status" aria-live="polite">
      <span id="toastMessage"></span>
      <button type="button" class="toast-close" onclick="hideToast()" aria-label="داخستن">✕</button>
    </div>

    <div class="header">
      <div class="header-top">
        <div class="brand">Patente B — Quiz &amp; Video</div>
        <button type="button" id="vipStatusBtn" class="badge-vip" onclick="focusVipOrInfo()">دۆخی VIP: قفڵە</button>
      </div>

      <div class="controls">
        <select id="chapterSelect" onchange="applyFilters()">
          <option value="all">هەموو بەشەکان (١ - ١٦)</option>
          <option value="video_vip">بەشی ڤیدیۆیی (VIP)</option>
        </select>

        <select id="langSelect" onchange="renderQuestion()">
          <option value="both">ئیتاڵی + کوردی</option>
          <option value="it">تەنها ئیتاڵی</option>
          <option value="sorani">کوردی سۆرانی</option>
          <option value="badini">کوردی بادینی</option>
        </select>

        <button type="button" class="btn-primary" onclick="startExamMode()">تاقیکردنەوەی ٣٠ پرسیار</button>
      </div>

      <div class="progress-wrap">
        <div id="progressBar" class="progress-bar"></div>
      </div>

      <div class="meta-row">
        <span id="counter">پرسیار ١ لە ٢</span>
        <span id="timerText">دۆخی خوێندنی ئاسایی</span>
      </div>
    </div>

    <div class="card">
      <div id="qIt" class="q-it"></div>
      <div id="qKu" class="q-ku"></div>

      <div class="media-area">
        <img id="qImg" alt="Road sign" />
        <video id="qVideo" controls playsinline preload="metadata"></video>

        <div id="vipLockBox" class="vip-lock">
          <h3>پرسیاری ڤیدیۆیی تایبەت (VIP)</h3>
          <p>بۆ بینینی ڤیدیۆی شیکاری و دۆخەکانی هاتوچۆ، کۆدی چالاککردنی تایبەت بە خۆت بنووسە.</p>
          <div class="vip-form">
            <input id="vipCodeInput" type="text" placeholder="کۆدی VIP بنووسە" />
            <button type="button" class="btn-vip" onclick="handleUnlockVip()">چالاککردن</button>
          </div>
        </div>
      </div>

      <div class="answers">
        <button type="button" class="btn-vero" onclick="submitAnswer(true)">VERO / ڕاستە</button>
        <button type="button" class="btn-falso" onclick="submitAnswer(false)">FALSO / هەڵەیە</button>
      </div>

      <div id="feedback" class="feedback"></div>

      <div class="nav">
        <button type="button" onclick="prevQuestion()">پرسیاری پێشوو</button>
        <button type="button" onclick="nextQuestion()">پرسیاری دواتر</button>
      </div>
    </div>
  </div>

  <script>
    /**
     * Sample quiz dataset for Patente B (Italian + Sorani + Badini).
     * Additional questions can be appended safely to this array.
     */
    const QUESTIONS = [
      {
        id: 1,
        chapter: 1,
        isVipVideo: false,
        it: "La carreggiata è la parte della strada destinata allo scorrimento dei veicoli.",
        sorani: "شەقامی ئۆتۆمبێل (Carreggiata) ئەو بەشەی ڕێگایە کە بۆ هاتوچۆی ئۆتۆمبێل تەرخان کراوە.",
        badini: "جادا ترۆمبێلا (Carreggiata) ئەو پشکا ڕێکێ یە کو بۆ هاتنوچوونا ترۆمبێلا هاتییە تەرخانکرن.",
        image: "",
        video: "",
        answer: true,
        exp_sorani: "ڕاستە؛ شەقامی ئۆتۆمبێل بەشێکی سەرەکیی ڕێگایە بۆ ڕۆیشتنی ئۆتۆمبێلەکان.",
        exp_badini: "ڕاستە؛ جادا ترۆمبێلا پشکەکا سەرەکی یا ڕێکێ یە بۆ چوونا ترۆمبێلان."
      },
      {
        id: 2,
        chapter: 5,
        isVipVideo: true,
        it: "In questa situazione video, il veicolo che sopraggiunge da destra ha la precedenza.",
        sorani: "لەم دۆخە ڤیدیۆییەدا، ئەو ئۆتۆمبێلەی لە لای ڕاستەوە دێت ئەولەوییەتی هەیە.",
        badini: "د ڤێ ڕەوشا ڤیدیۆیی دا، ترۆمبێلا کو ژ لایێ ڕاستێ ڤە دهێت ئەولەوییەت یا هەی.",
        image: "",
        video: "https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4",
        answer: true,
        exp_sorani: "لە یەکتربڕی بێ هێمادا، ئۆتۆمبێلی لای ڕاست ئەولەوییەتی هەیە.",
        exp_badini: "ل یەکتربڕا بێ هێما دا، ترۆمبێلا لایێ ڕاستێ ئەولەوییەت یا هەی."
      }
    ];

    /**
     * Safe storage helper to avoid runtime errors in restricted browsers.
     */
    function readStorage(key, fallbackValue) {
      try {
        const raw = localStorage.getItem(key);
        return raw !== null ? raw : fallbackValue;
      } catch (err) {
        console.warn("Storage read error:", err);
        return fallbackValue;
      }
    }

    function writeStorage(key, value) {
      try {
        localStorage.setItem(key, value);
      } catch (err) {
        console.warn("Storage write error:", err);
      }
    }

    // Application state
    let list = [...QUESTIONS];
    let idx = 0;
    let answers = {};
    let vipUnlocked = false;
    let timerInterval = null;
    let secondsLeft = 0;
    let toastTimeout = null;

    try {
      answers = JSON.parse(readStorage("patente_answers", "{}"));
      if (!answers || typeof answers !== "object") {
        answers = {};
      }
    } catch (err) {
      console.warn("Failed to parse saved answers:", err);
      answers = {};
    }

    vipUnlocked = readStorage("patente_vip_unlocked", "false") === "true";

    /**
     * Displays a non-intrusive notification message on screen.
     */
    function showToast(message, tone = "info") {
      const box = document.getElementById("toastBox");
      const textEl = document.getElementById("toastMessage");
      if (!box || !textEl) return;

      textEl.textContent = message;
      box.style.borderColor =
        tone === "success" ? "#22c55e" :
        tone === "error" ? "#ef4444" :
        tone === "vip" ? "#f59e0b" : "var(--border)";

      box.classList.add("show");
      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        hideToast();
      }, 4000);
    }

    function hideToast() {
      const box = document.getElementById("toastBox");
      if (box) {
        box.classList.remove("show");
      }
    }

    /**
     * Populates unique chapters into the chapter dropdown.
     */
    function initChapters() {
      try {
        const select = document.getElementById("chapterSelect");
        if (!select) return;

        const chapters = [...new Set(QUESTIONS.map(q => q.chapter))].sort((a, b) => a - b);
        chapters.forEach(ch => {
          const opt = document.createElement("option");
          opt.value = String(ch);
          opt.textContent = `بەشی ${ch}`;
          select.appendChild(opt);
        });
      } catch (err) {
        console.error("initChapters error:", err);
      }
    }

    /**
     * Updates VIP status badge style and text.
     */
    function updateVipBadge() {
      const btn = document.getElementById("vipStatusBtn");
      if (!btn) return;

      if (vipUnlocked) {
        btn.textContent = "دۆخی VIP: چالاکە ✓";
        btn.style.background = "rgba(34, 197, 94, 0.16)";
        btn.style.color = "#22c55e";
        btn.style.borderColor = "rgba(34, 197, 94, 0.4)";
      } else {
        btn.textContent = "دۆخی VIP: قفڵە";
        btn.style.background = "rgba(245, 158, 11, 0.16)";
        btn.style.color = "#f59e0b";
        btn.style.borderColor = "rgba(245, 158, 11, 0.4)";
      }
    }

    /**
     * Navigates to VIP section or informs user if already active.
     */
    function focusVipOrInfo() {
      if (vipUnlocked) {
        showToast("بەشی VIP بۆ تۆ چالاک کراوە.", "success");
      } else {
        const chapterSelect = document.getElementById("chapterSelect");
        if (chapterSelect) {
          chapterSelect.value = "video_vip";
        }
        applyFilters();
        showToast("کۆدی VIP بنووسە بۆ کردنەوەی ڤیدیۆ تایبەتەکان.", "vip");
      }
    }

    /**
     * Validates a VIP activation code.
     */
    async function verifyCodeInDatabase(code) {
      return typeof code === "string" && code.trim().length >= 4;
    }

    /**
     * Handles unlocking VIP access via input code.
     */
    async function handleUnlockVip() {
      try {
        const input = document.getElementById("vipCodeInput");
        const code = input ? input.value.trim().toUpperCase() : "";

        if (!code) {
          showToast("تکایە کۆدەکە بنووسە.", "error");
          return;
        }

        const ok = await verifyCodeInDatabase(code);
        if (ok) {
          vipUnlocked = true;
          writeStorage("patente_vip_unlocked", "true");
          updateVipBadge();
          showToast("بەشی VIP بە سەرکەوتوویی کرایەوە!", "success");
          renderQuestion();
        } else {
          showToast("کۆدەکە هەڵەیە؛ لانی کەم ٤ پیت یان ژمارە بێت.", "error");
        }
      } catch (err) {
        console.error("handleUnlockVip error:", err);
        showToast("هەڵەیەک لە کاتی چالاککردن ڕوویدا.", "error");
      }
    }

    /**
     * Filters questions by selected chapter or VIP video category.
     */
    function applyFilters() {
      try {
        const select = document.getElementById("chapterSelect");
        const val = select ? select.value : "all";

        clearInterval(timerInterval);
        timerInterval = null;
        document.getElementById("timerText").textContent = "دۆخی خوێندنی ئاسایی";

        if (val === "all") {
          list = [...QUESTIONS];
        } else if (val === "video_vip") {
          list = QUESTIONS.filter(q => q.isVipVideo);
        } else {
          list = QUESTIONS.filter(q => String(q.chapter) === val);
        }

        idx = 0;
        renderQuestion();
      } catch (err) {
        console.error("applyFilters error:", err);
      }
    }

    /**
     * Starts a 30-question timed exam session.
     */
    function startExamMode() {
      try {
        clearInterval(timerInterval);
        const shuffled = [...QUESTIONS].sort(() => Math.random() - 0.5);
        list = shuffled.slice(0, Math.min(30, shuffled.length));
        idx = 0;
        secondsLeft = 30 * 60;

        const updateTimerDisplay = () => {
          const safeSecs = Math.max(0, secondsLeft);
          const mins = Math.floor(safeSecs / 60);
          const secs = safeSecs % 60;
          document.getElementById("timerText").textContent =
            `کاتی ماوە: ${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;
        };

        updateTimerDisplay();

        timerInterval = setInterval(() => {
          secondsLeft--;
          updateTimerDisplay();

          if (secondsLeft <= 0) {
            clearInterval(timerInterval);
            timerInterval = null;
            showToast("کاتی تاقیکردنەوە تەواو بوو!", "info");
          }
        }, 1000);

        renderQuestion();
        showToast("تاقیکردنەوە دەستی پێ کرد.", "info");
      } catch (err) {
        console.error("startExamMode error:", err);
      }
    }

    /**
     * Updates overall completion progress bar and counter text.
     */
    function updateProgressUI() {
      const total = QUESTIONS.length || 1;
      const doneCount = Object.keys(answers).length;
      const pct = Math.min(100, Math.round((doneCount / total) * 100));

      const bar = document.getElementById("progressBar");
      const counter = document.getElementById("counter");

      if (bar) {
        bar.style.width = `${pct}%`;
      }
      if (counter) {
        const displayIndex = list.length > 0 ? idx + 1 : 0;
        counter.textContent = `پرسیار ${displayIndex} لە ${list.length}  |  تەواوکراو: ${pct}%`;
      }
    }

    /**
     * Renders the active question text, media, and lock state.
     */
    function renderQuestion() {
      try {
        const qIt = document.getElementById("qIt");
        const qKu = document.getElementById("qKu");
        const img = document.getElementById("qImg");
        const vid = document.getElementById("qVideo");
        const lockBox = document.getElementById("vipLockBox");
        const fb = document.getElementById("feedback");

        if (fb) {
          fb.style.display = "none";
          fb.innerHTML = "";
        }

        if (img) {
          img.style.display = "none";
          img.removeAttribute("src");
        }
        if (vid) {
          vid.style.display = "none";
          vid.pause();
          vid.removeAttribute("src");
        }
        if (lockBox) {
          lockBox.style.display = "none";
        }

        const q = list[idx];
        if (!q) {
          if (qIt) qIt.textContent = "";
          if (qKu) {
            qKu.style.display = "block";
            qKu.textContent = "هیچ پرسیارێک لەم بەشەدا نییە.";
          }
          updateProgressUI();
          return;
        }

        const langSelect = document.getElementById("langSelect");
        const lang = langSelect ? langSelect.value : "both";

        if (qIt) {
          qIt.style.display = (lang === "both" || lang === "it") ? "block" : "none";
          qIt.textContent = q.it || "";
        }

        if (qKu) {
          if (lang === "badini") {
            qKu.style.display = "block";
            qKu.textContent = q.badini || q.sorani || "";
          } else if (lang === "sorani" || lang === "both") {
            qKu.style.display = "block";
            qKu.textContent = q.sorani || q.badini || "";
          } else {
            qKu.style.display = "none";
          }
        }

        if (q.isVipVideo && !vipUnlocked) {
          if (lockBox) lockBox.style.display = "block";
        } else if (q.video && vid) {
          vid.src = q.video;
          vid.style.display = "block";
        } else if (q.image && img) {
          img.src = q.image;
          img.style.display = "block";
        }

        updateProgressUI();
      } catch (err) {
        console.error("renderQuestion error:", err);
        showToast("هەڵەیەک لە پیشاندانی پرسیارەکەدا ڕوویدا.", "error");
      }
    }

    /**
     * Records user answer (true = VERO, false = FALSO) and shows explanation.
     */
    function submitAnswer(choice) {
      try {
        const q = list[idx];
        if (!q) return;

        answers[q.id] = choice;
        writeStorage("patente_answers", JSON.stringify(answers));

        const langSelect = document.getElementById("langSelect");
        const lang = langSelect ? langSelect.value : "both";
        const exp = (lang === "badini")
          ? (q.exp_badini || q.exp_sorani || "")
          : (q.exp_sorani || q.exp_badini || "");

        const fb = document.getElementById("feedback");
        if (fb) {
          fb.style.display = "block";
          if (choice === q.answer) {
            fb.style.borderColor = "#22c55e";
            fb.innerHTML = `<strong style="color:#22c55e;">وەڵامەکەت ڕاستە!</strong><br>${exp}`;
          } else {
            fb.style.borderColor = "#ef4444";
            fb.innerHTML = `<strong style="color:#ef4444;">وەڵامەکەت هەڵەیە.</strong><br>${exp}`;
          }
        }

        updateProgressUI();
      } catch (err) {
        console.error("submitAnswer error:", err);
      }
    }

    /**
     * Advances to the next question in the current list.
     */
    function nextQuestion() {
      if (idx < list.length - 1) {
        idx++;
        renderQuestion();
      }
    }

    /**
     * Goes back to the previous question in the current list.
     */
    function prevQuestion() {
      if (idx > 0) {
        idx--;
        renderQuestion();
      }
    }

    // Initial boot
    initChapters();
    updateVipBadge();
    renderQuestion();
  </script>
</body>
</html>
